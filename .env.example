# Copiar a .env (nunca commitear .env). docker compose lo lee solo.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Puertos en el host (la app Flutter usa 10.0.2.2:5001 y 10.0.2.2:5002)
BANCO_PORT=5001
TIENDA_PORT=5002

# Banco.Api — llave AES-256 (32 bytes en base64) para la CLABE en BD, y secreto JWT (>= 32 chars)
# Generar: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
Seguridad__AesKey=
Seguridad__JwtKey=

# Secreto compartido tienda -> banco para POST /bonos/canjear (header X-Api-Key)
Seguridad__ApiKeyTienda=

# Solo si corres las APIs con `dotnet run` fuera de Docker (en Docker se fijan en el compose):
# Banco__Url=http://localhost:5001/
# Seguridad__KeysDir=keys
